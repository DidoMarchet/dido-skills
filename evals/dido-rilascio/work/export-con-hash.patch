+/**
+ * Dati di un customer per una richiesta GDPR arrivata al backoffice: profilo e
+ * sessioni attive, come l'export self-service. Solo SUPERADMIN (gate nel controller).
+ */
+export const exportCustomer = async (id, actorId, ipAddress) => {
+  const profile = await prisma.customer.findUnique({ where: { id } });
+  if (!profile) throw new HttpError(404, "Customer non trovato");
+  const sessions = await listPrincipalSessions({
+    principalType: CUSTOMER,
+    principalId: id,
+  });
+  await auditLogWithActor("warn", "CUSTOMER_DATA_EXPORTED_BY_ADMIN", actorId, {
+    actorType: STAFF,
+    targetId: id,
+    targetEmail: profile.email,
+    ip: ipAddress,
+  });
+  return { exportedAt: new Date(), profile, sessions };
+};
